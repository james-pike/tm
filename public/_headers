/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Robots-Tag: noindex, nofollow

# Cloudflare Pages serves static assets with `max-age=0, must-revalidate` unless
# told otherwise, so without the rules below EVERY asset — every product photo,
# every JS chunk — is revalidated on every page view. Those 304s are still
# requests, which is why this site's request count runs so far above the others.

# Build output is content-hashed (q-*.js, *-style.css): the filename changes when
# the content does, so it can never go stale. Cache it forever.
/build/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images (product photos, logos, heroes, favicons) live in public/ with stable
# filenames — /wt/122366_omf_fl-1.jpg, /skus/ATC1000-tamarack.png, /logo.png — so
# replacing an image reuses its name. NOT immutable (that would pin the old bytes
# forever); instead a month of caching plus a year of stale-while-revalidate, so
# repeat visits serve from cache and refresh in the background.
#
# Matched by extension rather than by directory so a new image dir is covered
# automatically. An earlier version listed dirs by hand and missed /skus — the
# newest and heaviest product-photo dir — which then revalidated on every view.
/*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/*.jpg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/*.jpeg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/*.avif
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/*.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

/*.ico
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

# One product photo has an uppercase .JPG extension. Cloudflare path matching is
# case-sensitive, so the /*.jpg rule above skips it — cover it explicitly.
/hat/30109107PS2_FRONT.JPG
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

# HTML is server-rendered per request and must not be cached by the browser.
/
  Cache-Control: public, max-age=0, must-revalidate
