# --- Database (Turso / libSQL) ---
TURSO_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# --- Staff login ---
# One shared password. The login screen shows two portals (Site Clerks → the
# full catalog, Labourers → a curated lineup of products tagged portals=["groupb"]
# in cm-admin). BOTH portals authenticate with APP_PASSWORD — the chosen portal
# only decides which product list is shown, not the credential.
APP_PASSWORD=your-password

# --- Email (Resend) ---
RESEND_API_KEY=re_...
RESEND_FROM=Tamarack Apparel <orders@yourdomain.ca>
ORDER_NOTIFY_TO=orders@yourdomain.ca

# --- Payments (Stripe) ---
# Secret key (test: sk_test_..., live: sk_live_...)
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret for the /api/stripe-webhook endpoint (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_...

# Public origin used to build Stripe success/cancel URLs. Optional — defaults to
# the request origin. Set it if you're behind a proxy or want to force https.
# SITE_URL=https://apparel.yourdomain.ca

# NOTE: the older VITE_-prefixed names (VITE_TURSO_URL, VITE_RESEND_API_KEY, ...)
# are still read as fallbacks for backward compatibility.
